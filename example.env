# Environment Variables for AI Software Engineer SaaS

# Database Connection
# For development with SQLite (as used initially):
# DATABASE_URL="file:./dev.db"
# For production with MySQL (recommended):
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth Configuration
# The canonical URL of your application
NEXTAUTH_URL="http://localhost:3000" # Change to your production URL
# A random secret used to sign tokens (generate one using `openssl rand -hex 32`)
NEXTAUTH_SECRET="YOUR_NEXTAUTH_SECRET_HERE"

# AI Provider API Keys
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"

# Stripe Configuration (Required for Subscription/Payments)
# Your Stripe secret key (keep this secure!)
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
# Your Stripe publishable key (safe to use in frontend)
STRIPE_PUBLIC_KEY="pk_test_YOUR_STRIPE_PUBLIC_KEY"
# Your Stripe webhook signing secret (for verifying webhook events)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# Optional: Add Stripe Price IDs for your subscription plans if needed
# STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
# STRIPE_PRO_YEARLY_PRICE_ID="price_..."

